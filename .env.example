# 复制本文件为 .env 后填写。等号左右不要写成冒号（曾因 KEY:value 写法静默为空）。
# 注意：密钥只保存在服务端 .env，永远不要写进前端 js / index.html。

# 从 https://platform.deepseek.com 创建，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=

# 现役模型：deepseek-flash（快、便宜、非思考，推荐结构化抽取）或 deepseek-v4-pro（强推理）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，不要再填写。
DEEPSEEK_MODEL=deepseek-flash

# OpenAI 兼容端点，通常无需改动。verify 端点会逐一比对候选值。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次分析最大输出 token。7 条重写 × 5 风格 + 10 面试追问 + 完整简历，16K 实测会截断。
DEEPSEEK_MAX_TOKENS=32000

# 访问口令（可选，但公开平台部署强烈建议设置）。
# 设置后，只有带 ?token=你的口令 的链接才能调用 /api/analyze 等接口，防止陌生人消耗你的 API 额度。
# 静态页面仍可打开，口令只保护 API。
APP_ACCESS_TOKEN=

# 强制使用本地 mock（1 = 强制，0 = 有 key 就走真实模型）
FORCE_MOCK=0

# 服务端口
PORT=5173
